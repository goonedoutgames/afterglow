<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Afterglow.ViewModels"
             xmlns:ctrl="using:Afterglow.Controls"
             x:Class="Afterglow.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <DockPanel>
    <!-- Right sidebar: search / filters / sort / display -->
    <Border DockPanel.Dock="Right" Classes="glass" Width="268" Margin="4,8,8,8" Padding="14,14" CornerRadius="16">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    ctrl:SmoothScroll.IsEnabled="True">
        <StackPanel Spacing="14">
          <TextBlock Text="Library" Classes="field-label" Margin="0" FontSize="15" />

          <StackPanel Spacing="6">
            <TextBox PlaceholderText="Search…" Text="{Binding Search}" MinHeight="36" />
            <Button Classes="accent" Content="Search" Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="ghost" Content="Check updates" Command="{Binding CheckUpdatesCommand}"
                    IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Filters" Classes="field-label" Margin="0" />
            <TextBlock Text="Status" Classes="caption" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StatusChoices}"
                      SelectedItem="{Binding StatusFilter}" DisplayMemberBinding="{Binding Label}" />
            <TextBlock Text="Installed" Classes="caption" Margin="0,4,0,0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding InstallChoices}"
                      SelectedItem="{Binding InstallFilter}" DisplayMemberBinding="{Binding Label}"
                      ToolTip.Tip="Show every hub game, or only titles installed on this PC" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Sort" Classes="field-label" Margin="0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SortChoices}"
                      SelectedItem="{Binding SortBy}" DisplayMemberBinding="{Binding Label}" />
          </StackPanel>

          <Border Classes="glass-chip" Padding="10,10">
            <StackPanel Spacing="8">
              <TextBlock Text="Display" Classes="field-label" Margin="0" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Content="Grid" Command="{Binding ToggleViewCommand}"
                        IsVisible="{Binding !GridView}" MinWidth="72" />
                <Button Classes="ghost" Content="List" Command="{Binding ToggleViewCommand}"
                        IsVisible="{Binding GridView}" MinWidth="72" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding GridView}">
                <TextBlock Text="Card size" Classes="caption" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CardSizeChoices}"
                          SelectedItem="{Binding CardSizeChoice}" DisplayMemberBinding="{Binding Label}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding LibraryCountLabel}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MediaStatus}" Classes="caption" TextWrapping="Wrap" Opacity="0.85" />
          <TextBlock Text="{Binding Error}" Foreground="#E35D6A" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer IsVisible="{Binding GridView}" Padding="6,10,6,18"
                  HorizontalScrollBarVisibility="Disabled"
                  ctrl:SmoothScroll.IsEnabled="True">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryItemViewModel">
            <Border Classes="game-card-host"
                    Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardWidth}"
                    Height="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardHeight}"
                    PointerPressed="GameCard_PointerPressed" Tag="{Binding}"
                    ToolTip.Tip="{Binding Title}">
              <Border Classes="game-card">
                <Border Classes="game-card-face">
                  <DockPanel>
                    <Border DockPanel.Dock="Bottom" Classes="game-card-meta" Padding="10,8">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Classes="status-badge status-sm"
                                  Background="{Binding StatusBadgeBrush}"
                                  BorderBrush="{Binding StatusBadgeBorder}">
                            <TextBlock Text="{Binding PlayStatusLabel}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="White" />
                          </Border>
                          <Border Classes="status-badge status-sm installed-chip"
                                  IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="6">
                          <TextBlock Text="You" Classes="star-label" VerticalAlignment="Center" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding UserStars}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StarSlotViewModel">
                                <Panel Width="14" Height="14">
                                  <TextBlock Text="★" FontSize="12" Width="14" Height="14"
                                             Foreground="#55FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             TextAlignment="Center" />
                                  <Border Width="{Binding FillWidth}" Height="14" HorizontalAlignment="Left" ClipToBounds="True">
                                    <TextBlock Text="★" FontSize="12" Width="14" Height="14"
                                               Foreground="#F5C542" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               TextAlignment="Center" />
                                  </Border>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Grid.Column="2" Text="{Binding UserRatingText}" Classes="caption"
                                     VerticalAlignment="Center" MinWidth="22" />

                          <TextBlock Grid.Row="1" Text="F95" Classes="star-label" VerticalAlignment="Center" />
                          <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding F95Stars}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StarSlotViewModel">
                                <Panel Width="14" Height="14">
                                  <TextBlock Text="★" FontSize="12" Width="14" Height="14"
                                             Foreground="#55FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             TextAlignment="Center" />
                                  <Border Width="{Binding FillWidth}" Height="14" HorizontalAlignment="Left" ClipToBounds="True">
                                    <TextBlock Text="★" FontSize="12" Width="14" Height="14"
                                               Foreground="#F5C542" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               TextAlignment="Center" />
                                  </Border>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding F95RatingText}" Classes="caption"
                                     VerticalAlignment="Center" Opacity="0.9" MinWidth="22" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Panel>
                      <Border Classes="cover-fallback" />
                      <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                              FallbackSource="{Binding Cover}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                  </DockPanel>
                </Border>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
             IsVisible="{Binding !GridView}" Margin="8" Padding="4"
             PointerReleased="List_PointerReleased">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryItemViewModel">
          <Border Classes="glass-chip" Padding="10,8" Margin="0,2" ToolTip.Tip="{Binding Title}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="56" Height="84" CornerRadius="8" ClipToBounds="True" Classes="cover-fallback">
                <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                        FallbackSource="{Binding Cover}"
                                        Stretch="UniformToFill"
                                        IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="status-badge status-sm"
                          Background="{Binding StatusBadgeBrush}"
                          BorderBrush="{Binding StatusBadgeBorder}">
                    <TextBlock Text="{Binding PlayStatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                  </Border>
                  <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="You" Classes="star-label" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UserRatingText}" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="F95" Classes="star-label" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding F95RatingText}" Classes="caption" VerticalAlignment="Center" Opacity="0.9" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="2" Classes="status-badge status-sm installed-chip"
                      IsVisible="{Binding IsInstalled}" VerticalAlignment="Center">
                <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold" Foreground="White" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
