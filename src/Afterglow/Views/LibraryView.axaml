<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Afterglow.ViewModels"
             xmlns:ctrl="using:Afterglow.Controls"
             x:Class="Afterglow.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="glass" Padding="14,12" Margin="8,8,8,4" CornerRadius="16">
      <StackPanel Spacing="12">
        <!-- Search / actions -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox PlaceholderText="Search library…" Text="{Binding Search}" MinHeight="36" />
          <Button Grid.Column="1" Classes="accent" Content="Search" Command="{Binding SearchCommand}" MinWidth="88" />
          <Button Grid.Column="2" Classes="ghost" Content="Check updates" Command="{Binding CheckUpdatesCommand}"
                  IsEnabled="{Binding !Busy}" />
          <Button Grid.Column="3" Classes="ghost" Content="Grid" Command="{Binding ToggleViewCommand}"
                  IsVisible="{Binding !GridView}" MinWidth="72" />
          <Button Grid.Column="3" Classes="ghost" Content="List" Command="{Binding ToggleViewCommand}"
                  IsVisible="{Binding GridView}" MinWidth="72" />
        </Grid>

        <!-- Filters (Steam-like) -->
        <StackPanel Spacing="6">
          <TextBlock Text="Filters" Classes="field-label" Margin="0" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Status" Classes="caption" VerticalAlignment="Center" MinWidth="48" />
              <ComboBox Width="150" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}"
                        DisplayMemberBinding="{Binding Label}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Library" Classes="caption" VerticalAlignment="Center" MinWidth="48" />
              <ComboBox Width="150" ItemsSource="{Binding InstallChoices}" SelectedItem="{Binding InstallFilter}"
                        DisplayMemberBinding="{Binding Label}"
                        ToolTip.Tip="Show every hub game, or only titles installed on this PC" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Sort (separate from filters) -->
        <StackPanel Spacing="6">
          <TextBlock Text="Sort" Classes="field-label" Margin="0" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="By" Classes="caption" VerticalAlignment="Center" MinWidth="48" />
            <ComboBox Width="180" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortBy}"
                      DisplayMemberBinding="{Binding Label}" />
          </StackPanel>
        </StackPanel>

        <!-- Display prefs (unrelated to filters/sort) -->
        <Border Classes="glass-chip" Padding="10,8" IsVisible="{Binding GridView}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Display" Classes="field-label" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="Card size" Classes="caption" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding CardSizeChoices}" SelectedItem="{Binding CardSizeChoice}"
                      DisplayMemberBinding="{Binding Label}" />
            <Button Classes="ghost" Content="List view" Command="{Binding ToggleViewCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="glass-chip" Padding="10,8" IsVisible="{Binding !GridView}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Display" Classes="field-label" Margin="0" VerticalAlignment="Center" />
            <Button Classes="ghost" Content="Grid view" Command="{Binding ToggleViewCommand}" />
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding LibraryCountLabel}" Classes="caption" />
        <TextBlock Text="{Binding MediaStatus}" Classes="caption" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Error}" Foreground="#E35D6A" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer IsVisible="{Binding GridView}" Padding="6,10,6,18"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryItemViewModel">
            <Border Classes="game-card-host"
                    Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardWidth}"
                    Height="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardHeight}"
                    PointerPressed="GameCard_PointerPressed" Tag="{Binding}"
                    ToolTip.Tip="{Binding Title}">
              <Border Classes="game-card">
                <Border Classes="game-card-face">
                  <DockPanel>
                    <Border DockPanel.Dock="Bottom" Classes="game-card-meta" Padding="10,8">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                          <TextBlock Text="{Binding PlayStatusLabel}" Classes="caption" Opacity="0.85"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding UserRatingLabel}" Classes="caption"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                          <TextBlock Text="{Binding F95RatingLabel}" Classes="caption" Opacity="0.85"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        </StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding IsInstalled}" Opacity="0.95">
                          <TextBlock Text="Installed" FontSize="10" Foreground="White" />
                        </Border>
                      </StackPanel>
                    </Border>
                    <Panel>
                      <Border Classes="cover-fallback" />
                      <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                              FallbackSource="{Binding Cover}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                  </DockPanel>
                </Border>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
             IsVisible="{Binding !GridView}" Margin="8" Padding="4"
             PointerReleased="List_PointerReleased">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryItemViewModel">
          <Border Classes="glass-chip" Padding="10,8" Margin="0,2" ToolTip.Tip="{Binding Title}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="56" Height="84" CornerRadius="8" ClipToBounds="True" Classes="cover-fallback">
                <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                        FallbackSource="{Binding Cover}"
                                        Stretch="UniformToFill"
                                        IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption" FontSize="12" />
                  <TextBlock Text="{Binding PlayStatusLabel}" Classes="caption" FontSize="12" />
                  <TextBlock Text="{Binding UserRatingLabel}" Classes="caption" FontSize="12" />
                  <TextBlock Text="{Binding F95RatingLabel}" Classes="caption" FontSize="12" Opacity="0.85" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,4"
                      IsVisible="{Binding IsInstalled}" VerticalAlignment="Center" Opacity="0.9">
                <TextBlock Text="Installed" FontSize="11" Foreground="White" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
