<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Afterglow.ViewModels"
             xmlns:ctrl="using:Afterglow.Controls"
             x:Class="Afterglow.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <DockPanel>
    <!-- Right sidebar: search / filters / sort / display -->
    <Border DockPanel.Dock="Right" Classes="glass" Width="280" Margin="4,8,8,8" Padding="12,14,8,14" CornerRadius="16"
            ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="2,0,10,0">
        <StackPanel Spacing="14" Margin="2,0,4,0">
          <TextBlock Text="Library" Classes="field-label" Margin="0" FontSize="15" />

          <StackPanel Spacing="6">
            <TextBox PlaceholderText="Search…" Text="{Binding Search}" MinHeight="36" />
            <Button Classes="accent" Content="Search" Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="ghost" Content="Check updates" Command="{Binding CheckUpdatesCommand}"
                    IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Filters" Classes="field-label" Margin="0" />
            <TextBlock Text="Status" Classes="caption" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StatusChoices}"
                      SelectedItem="{Binding StatusFilter}" DisplayMemberBinding="{Binding Label}" />
            <TextBlock Text="Installed" Classes="caption" Margin="0,4,0,0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding InstallChoices}"
                      SelectedItem="{Binding InstallFilter}" DisplayMemberBinding="{Binding Label}"
                      ToolTip.Tip="Show every hub game, or only titles installed on this PC" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Sort" Classes="field-label" Margin="0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SortChoices}"
                      SelectedItem="{Binding SortBy}" DisplayMemberBinding="{Binding Label}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Tags" Classes="field-label" Margin="0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="Clear" Padding="8,4" MinHeight="28"
                      Command="{Binding ClearTagFiltersCommand}" IsVisible="{Binding HasSelectedTags}" />
            </Grid>
            <TextBlock Text="{Binding SelectedTagsLabel}" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding HasSelectedTags}" />
            <ItemsControl ItemsSource="{Binding AvailableTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryTagFilterItem">
                  <Border Classes="tag-filter-chip" Classes.is-selected="{Binding IsSelected}"
                          PointerPressed="TagFilter_PointerPressed" Tag="{Binding}">
                    <TextBlock Text="{Binding Label}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Text="No tags in library yet."
                       IsVisible="{Binding !AvailableTags.Count}" />
          </StackPanel>

          <Border Classes="glass-chip" Padding="10,10">
            <StackPanel Spacing="8">
              <TextBlock Text="Display" Classes="field-label" Margin="0" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Content="Grid" Command="{Binding ToggleViewCommand}"
                        IsVisible="{Binding !GridView}" MinWidth="72" />
                <Button Classes="ghost" Content="List" Command="{Binding ToggleViewCommand}"
                        IsVisible="{Binding GridView}" MinWidth="72" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding GridView}">
                <TextBlock Text="Card size" Classes="caption" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CardSizeChoices}"
                          SelectedItem="{Binding CardSizeChoice}" DisplayMemberBinding="{Binding Label}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding LibraryCountLabel}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MediaStatus}" Classes="caption" TextWrapping="Wrap" Opacity="0.85" />
          <TextBlock Text="{Binding Error}" Foreground="#E35D6A" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer IsVisible="{Binding GridView}" Padding="6,10,6,18"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryItemViewModel">
            <Border Classes="game-card-host"
                    Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardWidth}"
                    Height="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardHeight}"
                    PointerPressed="GameCard_PointerPressed" Tag="{Binding}">
              <Border Classes="game-card">
                <Border Classes="game-card-face">
                  <DockPanel>
                    <Border DockPanel.Dock="Bottom" Classes="game-card-meta" Padding="12,10">
                      <StackPanel Spacing="6">
                        <ctrl:MarqueeText Text="{Binding Title}" FontWeight="SemiBold"
                                          FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}"
                                          Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />

                        <Border Classes="status-badge status-sm" HorizontalAlignment="Left"
                                Background="{Binding StatusBadgeBrush}"
                                BorderBrush="{Binding StatusBadgeBorder}">
                          <TextBlock Text="{Binding PlayStatusLabel}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="White" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="&#xE121;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                     Classes="caption" FontSize="13" VerticalAlignment="Center"
                                     ToolTip.Tip="Playtime" />
                          <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption" VerticalAlignment="Center"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        </StackPanel>

                        <ctrl:TagBadges Tags="{Binding Tags}" Limit="3" Size="sm" Expandable="False" Clickable="False" />

                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3" ColumnSpacing="6">
                          <TextBlock Text="You" Classes="star-label" VerticalAlignment="Center"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding UserStars}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StarSlotViewModel">
                                <Panel Width="15" Height="15">
                                  <TextBlock Text="★" FontSize="13" Width="15" Height="15"
                                             Foreground="#40FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             TextAlignment="Center" />
                                  <Border Width="{Binding FillWidth}" Height="15" HorizontalAlignment="Left" ClipToBounds="True">
                                    <TextBlock Text="★" FontSize="13" Width="15" Height="15"
                                               Foreground="#D6DEE8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               TextAlignment="Center" />
                                  </Border>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Grid.Column="2" Text="{Binding UserRatingText}" Classes="caption"
                                     VerticalAlignment="Center" MinWidth="24"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />

                          <TextBlock Grid.Row="1" Text="F95" Classes="star-label" VerticalAlignment="Center"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                          <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding F95Stars}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StarSlotViewModel">
                                <Panel Width="15" Height="15">
                                  <TextBlock Text="★" FontSize="13" Width="15" Height="15"
                                             Foreground="#40FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             TextAlignment="Center" />
                                  <Border Width="{Binding FillWidth}" Height="15" HorizontalAlignment="Left" ClipToBounds="True">
                                    <TextBlock Text="★" FontSize="13" Width="15" Height="15"
                                               Foreground="#D6DEE8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               TextAlignment="Center" />
                                  </Border>
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding F95RatingText}" Classes="caption"
                                     VerticalAlignment="Center" Opacity="0.9" MinWidth="24"
                                     FontSize="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).MetaFontSize}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Panel>
                      <Border Classes="cover-fallback" />
                      <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                              FallbackSource="{Binding Cover}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <!-- Installed corner ribbon -->
                      <Panel Width="54" Height="54" HorizontalAlignment="Right" VerticalAlignment="Top"
                             IsVisible="{Binding IsInstalled}" IsHitTestVisible="False">
                        <Path Fill="#E03D9CF0" Data="M 0,0 L 54,0 L 54,54 Z" />
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="15" Foreground="White"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,6,7,0" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="10" Foreground="#B8FFD0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,18,5,0" />
                      </Panel>
                    </Panel>
                  </DockPanel>
                </Border>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
             IsVisible="{Binding !GridView}" Margin="8" Padding="4"
             PointerReleased="List_PointerReleased">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryItemViewModel">
          <Border Classes="glass-chip" Padding="10,8" Margin="0,2">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Width="56" Height="84">
                <Border Width="56" Height="84" CornerRadius="8" ClipToBounds="True" Classes="cover-fallback">
                  <ctrl:AnimatedImageView Media="{Binding CoverAnimation}"
                                          FallbackSource="{Binding Cover}"
                                          Stretch="UniformToFill"
                                          IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Border>
                <Panel Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
                       IsVisible="{Binding IsInstalled}" IsHitTestVisible="False">
                  <Path Fill="#E03D9CF0" Data="M 0,0 L 36,0 L 36,36 Z" />
                  <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                             FontSize="11" Foreground="White"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" />
                </Panel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="status-badge status-sm"
                          Background="{Binding StatusBadgeBrush}"
                          BorderBrush="{Binding StatusBadgeBorder}">
                    <TextBlock Text="{Binding PlayStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="&#xE121;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                               Classes="caption" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlaytimeLabel}" Classes="caption" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <ctrl:TagBadges Tags="{Binding Tags}" Limit="3" Size="sm" Expandable="False" Clickable="False" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="You" Classes="star-label" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UserRatingText}" Classes="caption" VerticalAlignment="Center" FontSize="13" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="F95" Classes="star-label" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding F95RatingText}" Classes="caption" VerticalAlignment="Center" Opacity="0.9" FontSize="13" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
