<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Afterglow.ViewModels"
             xmlns:core="using:Afterglow.Core.Models"
             xmlns:ctrl="using:Afterglow.Controls"
             x:Class="Afterglow.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
  <DockPanel>
    <!-- Right sidebar: search / sort / filters / tags -->
    <Border DockPanel.Dock="Right" Classes="glass" Width="300" Margin="4,8,8,8" Padding="12,14,8,14" CornerRadius="16"
            ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="2,0,10,0">
        <StackPanel Spacing="14" Margin="2,0,4,0">
          <TextBlock Text="Browse" Classes="field-label" Margin="0" FontSize="15" />

          <StackPanel Spacing="6">
            <TextBox PlaceholderText="Search title…" Text="{Binding Query}" MinHeight="36" />
            <Button Classes="accent" Content="Search" Command="{Binding SearchCommand}"
                    IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Sort" Classes="field-label" Margin="0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SortChoices}"
                      SelectedItem="{Binding SortBy}" DisplayMemberBinding="{Binding Label}" />
            <TextBlock Text="Updated" Classes="caption" Margin="0,4,0,0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DateChoices}"
                      SelectedItem="{Binding DatePreset}" DisplayMemberBinding="{Binding Label}" />
            <TextBlock Text="Engine" Classes="caption" Margin="0,4,0,0" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EngineChoices}"
                      SelectedItem="{Binding Engine}" DisplayMemberBinding="{Binding Label}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Tags" Classes="field-label" Margin="0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="Clear" Padding="8,4" MinHeight="28"
                      Command="{Binding ClearIncludeTagsCommand}" IsVisible="{Binding HasIncludeTags}" />
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="F95 catalog tags (numeric IDs under the hood). Works with sort and date." />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TagModeOptions}"
                      SelectedItem="{Binding TagMode}" DisplayMemberBinding="{Binding Label}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox PlaceholderText="Filter / add tag…" Text="{Binding TagDraft}" MinHeight="36" />
              <Button Grid.Column="1" Classes="ghost" Content="Add" Command="{Binding AddIncludeTagCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding IncludeTags}" IsVisible="{Binding HasIncludeTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="tag-filter-chip is-selected"
                          PointerPressed="IncludeTag_PointerPressed" Tag="{Binding}">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="glass-chip" Padding="8,8" MaxHeight="220">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                  <TextBlock Text="F95 tags" Classes="caption" />
                  <ItemsControl ItemsSource="{Binding CatalogTagSuggestions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:CatalogTag">
                        <Border Classes="tag-filter-chip"
                                PointerPressed="CatalogTag_PointerPressed" Tag="{Binding}">
                          <TextBlock Text="{Binding Name}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="No matching tags."
                             IsVisible="{Binding !CatalogTagSuggestions.Count}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Add to library" Classes="field-label" Margin="0" />
            <TextBox PlaceholderText="F95 URL or thread id…" Text="{Binding AddByUrl}" MinHeight="36" />
            <Button Classes="ghost" Content="Add URL" Command="{Binding AddByUrlCommand}"
                    IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
            <Button Classes="ghost" Content="Prev" Command="{Binding PrevPageCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding Page, StringFormat=Page {0}}"
                       VerticalAlignment="Center" Classes="muted" />
            <Button Grid.Column="2" Classes="ghost" Content="Next" Command="{Binding NextPageCommand}" />
          </Grid>

          <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Error}" Foreground="#E35D6A" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="6,10,6,18">
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogItemViewModel">
            <Border Classes="game-card-host" Width="220" Height="400">
              <Border Classes="game-card">
                <Border Classes="game-card-face">
                  <DockPanel>
                    <Border DockPanel.Dock="Bottom" Classes="game-card-meta" Padding="10,8">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" Classes="caption" />
                        <ctrl:TagBadges Tags="{Binding Tags}" Limit="4" Size="sm" Expandable="True" Clickable="False" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <Button Classes="accent" Content="{Binding AddButtonLabel}"
                                  Command="{Binding $parent[UserControl].((vm:BrowseViewModel)DataContext).AddCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsInLibrary}" />
                          <Button Grid.Column="1" Classes="ghost" Content="F95"
                                  Command="{Binding $parent[UserControl].((vm:BrowseViewModel)DataContext).OpenThreadCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Panel>
                      <Border Classes="cover-fallback" />
                      <Image Source="{Binding Cover}" Stretch="UniformToFill"
                             IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                  </DockPanel>
                </Border>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
