<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:Afterglow.Controls">
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, IBM Plex Sans, sans-serif" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.help">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Frosted glass panels: translucent fill + bright rim + soft depth -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 10 36 0 #55000000, 0 1 0 0 #28FFFFFF" />
  </Style>
  <Style Selector="Border.glass-strong">
    <Setter Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 14 44 0 #66000000, 0 1 0 0 #33FFFFFF" />
  </Style>
  <Style Selector="Border.glass-chip">
    <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #44000000" />
  </Style>
  <Style Selector="Border.cover-fallback">
    <Setter Property="Background" Value="#33182028" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ToastFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 18 48 0 #AA000000, 0 1 0 0 #44FFFFFF" />
  </Style>
  <Style Selector="Border.toast TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.toast TextBlock.caption">
    <Setter Property="Foreground" Value="#C8D2E0" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="#38FFFFFF" />
    <Setter Property="BorderBrush" Value="#55FFFFFF" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="#28FFFFFF" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
  </Style>
  <Style Selector="Button.nav ProgressBar">
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="Button.window-chrome">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI, Noto Sans, DejaVu Sans, sans-serif" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-chrome:pointerover">
    <Setter Property="Background" Value="#28FFFFFF" />
  </Style>
  <Style Selector="Button.window-chrome.close:pointerover">
    <Setter Property="Background" Value="#E35D6A" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="#55FFFFFF" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    <Setter Property="Background" Value="#3AFFFFFF" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="#28FFFFFF" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsScrollInertiaEnabled" Value="True" />
    <Setter Property="ctrl:SmoothScroll.IsEnabled" Value="True" />
  </Style>

  <!--
    Card hover glow lives on the HOST (ClipToBounds=False + padding), never on the
    clipped face — that was cutting the accent rim at the top corners.
  -->
  <Style Selector="Border.game-card-host">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.game-card-host:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource CardHoverGlow}" />
  </Style>
  <Style Selector="Border.game-card">
    <!-- Glass plate; do NOT ClipToBounds here or the border/glow corners shear off -->
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #44000000" />
  </Style>
  <Style Selector="Border.game-card-host:pointerover Border.game-card">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    <Setter Property="Background" Value="{DynamicResource GlassCardHoverBrush}" />
  </Style>
  <!-- Inner face clips cover art to rounded corners without eating the outer rim -->
  <Style Selector="Border.game-card-face">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.game-card-meta">
    <Setter Property="CornerRadius" Value="0,0,13,13" />
    <Setter Property="Background" Value="{DynamicResource GlassMetaBrush}" />
    <Setter Property="BorderBrush" Value="#18FFFFFF" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.star-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.status-badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="#663A4658" />
    <Setter Property="BorderBrush" Value="#885A6A7E" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.status-badge.status-sm">
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.status-badge.installed-chip">
    <Setter Property="Background" Value="#AA3D9CF0" />
    <Setter Property="BorderBrush" Value="#CC3D9CF0" />
  </Style>
  <Style Selector="Button.status-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.status-pill:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.star-hit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.star-hit:pointerover">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#28FFFFFF" />
  </Style>
</Styles>
